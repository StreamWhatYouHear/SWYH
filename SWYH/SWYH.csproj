<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>SWYH</RootNamespace>
    <AssemblyName>SWYH</AssemblyName>
    <ApplicationIcon>Resources\Icons\swyh128.ico</ApplicationIcon>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Deterministic>false</Deterministic>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="NAudio.Lame" Version="2.1.0" />
    <PackageReference Include="UPnP" Version="1.2.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DeveloperToolsForUPnPTechnologies\UPNPAVCDSML\UPnPAVCDSML.csproj" />
    <ProjectReference Include="..\DeveloperToolsForUPnPTechnologies\UPNPAV_RendererStack\UPnPAV_RendererStack.csproj" />
    <ProjectReference Include="..\DeveloperToolsForUPnPTechnologies\UPNP_AV\UPnPAV.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\Icons\swyh128.ico" />
    <Resource Include="Resources\Icons\swyh128.png" />
    <Resource Include="Resources\Icons\swyh16.ico" />
    <Resource Include="Resources\Icons\swyh16.png" />
    <Resource Include="Resources\Icons\swyh32.ico" />
    <Resource Include="Resources\Icons\swyh32.png" />
    <Resource Include="Resources\Icons\swyh48.ico" />
    <Resource Include="Resources\Icons\swyh48.png" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Resources\About.htm" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Resources\Error404.htm" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\THIRD-PARTY-LICENSES\**\*" Link="THIRD-PARTY-LICENSES\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\SWYH.licenseheader" Link="SWYH.licenseheader" />
    <None Update="Properties\Settings.settings" Generator="SettingsSingleFileGenerator" LastGenOutput="Settings.Designer.cs" />
  </ItemGroup>
</Project>
