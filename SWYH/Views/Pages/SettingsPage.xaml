<Page x:Class="SWYH.Views.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      Title="Settings">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Text="Settings" FontSize="22" FontWeight="Bold"/>
            <ui:Button Margin="0,8,0,0" Appearance="Info" Content="A new version is available - Update now"
                       Command="{Binding UpdateCommand}" Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVisibilityConverter}}"/>

            <TextBlock Text="STREAM TO DLNA DEVICE USING" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontWeight="SemiBold" Margin="0,20,0,6"/>
            <StackPanel Orientation="Horizontal">
                <RadioButton Content="MP3" GroupName="StreamFormat" Margin="0,0,20,0" IsChecked="{Binding IsMp3}"/>
                <RadioButton Content="PCM/L16" GroupName="StreamFormat" IsChecked="{Binding IsMp3, Converter={StaticResource InverseBooleanConverter}}"/>
            </StackPanel>

            <TextBlock Text="CAPTURE FORMAT" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontWeight="SemiBold" Margin="0,20,0,6"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ComboBox Grid.Column="0" ItemsSource="{Binding CaptureFormats}" DisplayMemberPath="DisplayName"
                          SelectedItem="{Binding SelectedCaptureFormat}"/>
                <ComboBox Grid.Column="2" ItemsSource="{Binding Bitrates}" SelectedItem="{Binding SelectedBitrate}" ToolTip="MP3 bitrate (kbps)"/>
            </Grid>

            <TextBlock Text="AUDIO SOURCE" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontWeight="SemiBold" Margin="0,20,0,6"/>
            <ComboBox ItemsSource="{Binding AudioDevices}" SelectedItem="{Binding SelectedAudioDevice}">
                <ComboBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock FontWeight="Bold" Text="{Binding Name}"/>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ComboBox.GroupStyle>
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <TextBlock Text="GENERAL" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontWeight="SemiBold" Margin="0,20,0,6"/>
            <CheckBox Content="Automatically run SWYH when I log in" Margin="0,0,0,8" IsChecked="{Binding RunAtWindowsStartup}"/>
            <CheckBox Content="Log unhandled errors" Margin="0,0,0,8" IsChecked="{Binding DebugLogging}"/>
            <CheckBox x:Name="cbUseSpecificPort" Content="Use specific HTTP port" Margin="0,0,0,8" IsChecked="{Binding UseSpecificPort}"/>
            <TextBox x:Name="textBox1" Width="90" HorizontalAlignment="Left" IsEnabled="{Binding UseSpecificPort}"
                     Text="{Binding HttpPortText, UpdateSourceTrigger=PropertyChanged}"
                     PreviewTextInput="textBox1_PreviewTextInput"/>

            <ui:Button Content="Save" Appearance="Primary" Margin="0,24,0,0" HorizontalAlignment="Stretch"
                       Height="40" Command="{Binding SaveCommand}"/>
        </StackPanel>
    </ScrollViewer>
</Page>
