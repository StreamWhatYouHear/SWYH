<Page x:Class="SWYH.Views.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Settings">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Text="Settings" FontSize="22" FontWeight="Bold"/>
            <ui:Button x:Name="btUpdate" Margin="0,8,0,0" Appearance="Info" Content="A new version is available - Update now"
                       Click="btUpdate_Click" Visibility="Collapsed"/>

            <TextBlock Text="STREAM TO DLNA DEVICE USING" FontSize="11" Foreground="Gray" FontWeight="SemiBold" Margin="0,20,0,6"/>
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="radioButton1" Content="MP3" GroupName="StreamFormat" Margin="0,0,20,0"/>
                <RadioButton x:Name="radioButton2" Content="PCM/L16" GroupName="StreamFormat"/>
            </StackPanel>

            <TextBlock Text="CAPTURE FORMAT" FontSize="11" Foreground="Gray" FontWeight="SemiBold" Margin="0,20,0,6"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ComboBox Grid.Column="0" x:Name="comboBox1"/>
                <ComboBox Grid.Column="2" x:Name="comboBox2" ToolTip="MP3 bitrate (kbps)"/>
            </Grid>

            <TextBlock Text="AUDIO SOURCE" FontSize="11" Foreground="Gray" FontWeight="SemiBold" Margin="0,20,0,6"/>
            <ComboBox x:Name="comboBoxDevice" SelectedValuePath="ID">
                <ComboBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock FontWeight="Bold" Text="{Binding Name}"/>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ComboBox.GroupStyle>
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <TextBlock Text="GENERAL" FontSize="11" Foreground="Gray" FontWeight="SemiBold" Margin="0,20,0,6"/>
            <CheckBox x:Name="cbRunAtWindowsStartup" Content="Automatically run SWYH when I log in" Margin="0,0,0,8"/>
            <CheckBox x:Name="cbDebug" Content="Log unhandled errors" Margin="0,0,0,8"/>
            <CheckBox x:Name="cbUseSpecificPort" Content="Use specific HTTP port" Checked="cbUseSpecificPort_Checked" Margin="0,0,0,8"/>
            <TextBox x:Name="textBox1" Width="90" HorizontalAlignment="Left" IsEnabled="{Binding IsChecked, ElementName=cbUseSpecificPort}"
                     PreviewTextInput="textBox1_PreviewTextInput"/>

            <ui:Button x:Name="btValid" Content="Save" Appearance="Primary" Margin="0,24,0,0" HorizontalAlignment="Stretch"
                       Height="40" Click="btValid_Click"/>
        </StackPanel>
    </ScrollViewer>
</Page>
