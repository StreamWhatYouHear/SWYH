<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>UPNPAV_RendererStack</RootNamespace>
    <AssemblyName>UPNPAV_RendererStack</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Deterministic>false</Deterministic>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="CpAVTransport.cs" />
    <Compile Remove="CpConnectionManager.cs" />
    <Compile Remove="CpRenderingControl.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="UPnP" Version="1.2.1" />
    <ProjectReference Include="..\UPNP_AV\UPnPAV.csproj" />
    <ProjectReference Include="..\UPNPAVCDSML\UPnPAVCDSML.csproj" />
  </ItemGroup>
</Project>
